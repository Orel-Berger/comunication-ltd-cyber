{
  "password_policy": {
    "min_length": 10,
    "require_uppercase": true,
    "require_lowercase": true,
    "require_digits": true,
    "require_special_characters": true,
    "special_characters_allowed": "!@#$%^&*()_+-=[]{}|;:,.<>?",
    "history_count": 3,
    "max_login_attempts": 3,
    "lockout_duration_minutes": 15,
    "dictionary_blacklist": [
      "password",
      "1234567890",
      "comunication",
      "communication",
      "qwertyuiop",
      "admin12345",
      "iloveyou123",
      "welcome123"
    ]
  }
}
